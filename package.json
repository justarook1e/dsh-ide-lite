{
  "name": "@justarook1e/dsh-ide-lite",
  "version": "1.32.1",
  "description": "Workspace file browser with agent-change review (accept/reject + undo), full user editing (undo/redo, save, auto-save), diff view and rendered markdown, plus an integrated terminal view with auto-detected project run targets (static host+client plugin)",
  "type": "module",
  "main": "host/index.mjs",
  "exports": {
    ".": "./host/index.mjs",
    "./client": "./client/dist/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "files": [
    "host/",
    "client/dist/",
    "cordis.patch.yml",
    "README.md",
    "THIRD_PARTY_LICENSES.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "dsh-plugin",
    "ide",
    "file-editor",
    "file-tree",
    "diff",
    "code-review",
    "terminal"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justarook1e/dsh-ide-lite.git"
  },
  "homepage": "https://github.com/justarook1e/dsh-ide-lite#readme",
  "bugs": {
    "url": "https://github.com/justarook1e/dsh-ide-lite/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
